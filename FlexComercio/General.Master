<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="General.master.cs" Inherits="FlexComercio.General" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
</head>
<body>
    <form id="form1" runat="server">
       
<!-- HEADER SUPERIOR -->
<header class="bg-black text-white shadow-sm">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center py-3">

            <!-- Logo -->
            <div class="d-flex align-items-center">

                <div class="me-3">
                    <i class="bi bi-cart3 fs-1"></i>
                </div>

                <div>
                    <h3 class="fw-bold mb-0">
                        Sistema de Gestión
                    </h3>

                    <small class="text-light opacity-75">
                        Compras y Ventas
                    </small>
                </div>

            </div>

            <!-- Usuario -->
            <div class="d-flex align-items-center">

                <div class="text-end me-3">
                    <h5 class="fw-bold mb-0">
                        Administrador
                    </h5>

                    <small class="text-light opacity-75">
                        Administrador
                    </small>
                </div>

                <button class="btn btn-outline-light rounded-4">
                    <i class="bi bi-box-arrow-right fs-5"></i>
                </button>

            </div>

        </div>

    </div>
</header>

<!-- MENÚ -->
<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
    <div class="container-fluid">

        <div class="collapse navbar-collapse show">

            <ul class="navbar-nav w-100">

                <li class="nav-item">
                    <a id="lnkFlux" runat="server"
                        class="nav-link px-4 py-3"
                        href="#">
                        Flux
                    </a>
                </li>

                <li class="nav-item">
                  <a id="lnkInicio" runat="server"
                    class="nav-link px-4 py-3"
                        href="Default.aspx">
                      <i class="bi bi-house-door me-2"></i>
                        Inicio
                   </a>
                </li>

                <li class="nav-item">
                   <a id="lnkVentas" runat="server"
                        class="nav-link px-4 py-3"
                        href="Venta.aspx">

                       <i class="bi bi-cart me-2"></i>
                        Ventas
                    </a>
                </li>

                <li class="nav-item">
                    <a id="lknClientes" runat="server"
                       class="nav-link px-4 py-3"
                        href= "Cliente.aspx">
                        <i class="bi bi-people me-2"></i>
                        Clientes
                    </a>
                </li>

                <li class="nav-item">
                    <a id="lnkProveedor" runat="server"
                        class="nav-link px-4 py-3"
                        href="Proveedor.aspx">
                       <i class="bi bi-truck me-2"></i>
                        Proveedores
                    </a>
                </li>

                <li class="nav-item">
                    <a id="lnkProductos" runat="server"
                        class="nav-link px-4 py-3"
                        href="Producto.aspx">
                        <i class="bi bi-box-seam me-2"></i>
                        Productos
                    </a>
                </li>

                <li class="nav-item">
                    <a id="lnkMarcaYCategoria" runat="server"
                        class="nav-link px-4 py-3"
                        href="MarcaYCategoria.aspx">
                        <i class="bi bi-tag me-2"></i>
                        Marcas y Categorías
                    </a>
                </li>

                <li class="nav-item">
                    <a id="lnkCompras" runat="server"
                        class="nav-link px-4 py-3"
                        href="Compras.aspx">
                        <i class="bi bi-bag me-2"></i>
                        Compras
                    </a>
                </li>

                <li class="nav-item">
                    <a id="lnkReporte" runat="server"
                        class="nav-link px-4 py-3"
                        href="Reporte.aspx">
                        <i class="bi bi-bar-chart me-2"></i>
                        Reportes
                    </a>
                </li>

            </ul>

        </div>

    </div>
</nav>
<asp:ContentPlaceHolder ID="MainContent" runat="server">
</asp:ContentPlaceHolder>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
