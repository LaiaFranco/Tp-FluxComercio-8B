<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Vendedor.Master.cs" Inherits="FlexComercio.Cliente1" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
</head>
<body>
    <form id="form1" runat="server">
        <div>
                <!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<!-- NAVBAR SUPERIOR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-black py-2">
    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand me-4" href="#">
            <img src="logoFLUX.png" alt="Logo" height="65">
        </a>

        <!-- Categorías -->
        

            <!-- Buscador -->
            <form class="d-flex flex-grow-1 me-4">
                <div class="input-group">

                    <input
                        class="form-control rounded-start-pill border-0"
                        type="search"
                        placeholder="Buscar...">

                    <button class="btn btn-light rounded-end-pill">
                        <i class="bi bi-search"></i>
                    </button>

                </div>
            </form>

            <!-- Cuenta -->
            <ul class="navbar-nav">

                <li class="nav-item dropdown me-3">
                    <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person"></i> Crea tu cuenta
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#">Iniciar sesión</a></li>
                        <li><a class="dropdown-item" href="#">Registrarse</a></li>
                    </ul>

                </li>

                <!-- Carrito -->
                <li class="nav-item">
                    <a class="btn btn-success fw-bold px-4" href="#">
                        <i class="bi bi-cart-fill"></i>
                        MI CARRITO
                    </a>
                </li>

            </ul>

        </div>

    </div>
</nav>

<!-- NAVBAR INFERIOR -->
<nav class="navbar navbar-expand bg-white border-bottom shadow-sm">
    <div class="container justify-content-center">

        <ul class="navbar-nav gap-5">

            <li class="nav-item">
                <a class="nav-link text-dark" href="#">
                    <i class="bi bi-heart me-2"></i>Productos
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark" href="#">
                    <i class="bi bi-person me-2"></i>Categorias
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark" href="#">
                    <i class="bi bi-gear me-2"></i>Marcas
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark" href="#">
                    <i class="bi bi-journal-text me-2"></i>Formas de pago
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-dark" href="#">
                    <i class="bi bi-credit-card me-2"></i>Descuentos bancarios
                </a>
            </li>

        </ul>

    </div>
</nav>
    <asp:ContentPlaceHolder ID="MainContent" runat="server">
    </asp:ContentPlaceHolder>
        </form>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
