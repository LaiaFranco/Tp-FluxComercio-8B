<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Vendedor.Master.cs" Inherits="FlexComercio.Cliente1" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <!-- HEADER SUPERIOR -->
<header class="bg-black text-white shadow-sm">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center py-3">

            <!-- Logo -->
            <div class="d-flex align-items-center">

                <div class="me-3">
                    <img src="logoFLUX.png" alt="Logo" class="logo-sidebar me-3" style =" width: 120px;height: 120px;object-fit: contain;">
                </div>

                <div>
                    <h3 class="fw-bold mb-0">
                        Sistema de Gestión
                    </h3>

                    <small class="text-light opacity-75">
                        Compras y Ventas
                    </small>
                </div>

            </div>

            <!-- Usuario -->
            <div class="d-flex align-items-center">

                <div class="text-end me-3">
                   <h5 class="fw-bold mb-0">
                        <asp:Label ID="lblNombreUsuario" runat="server" />
                    </h5>

                    <small class="text-light opacity-75">
                        Vendededor
                    </small>
                </div>
                     <!-- PERFIL DROPDOWN -->
<div class="dropdown">

    <button class="btn btn-outline-light dropdown-toggle rounded-pill px-3"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">

        <i class="bi bi-person me-2"></i>
        Perfil
    </button>

    <ul class="dropdown-menu dropdown-menu-end shadow">

        <!-- Registrar usuario -->
        

        <!-- Cerrar sesión -->
        <li>
            <a class="dropdown-item text-danger" href="Login.aspx">
                <i class="bi bi-box-arrow-right me-2"></i>
                Cerrar sesión
            </a>
        </li>

    </ul>

</div>

            </div>

        </div>

    </div>
</header>

<!-- MENÚ -->
<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
    <div class="container-fluid">

        <div class="collapse navbar-collapse show">

            <ul class="navbar-nav w-100">

                <li class="nav-item">
                    <a id="lnkFlux" runat="server"
                        class="nav-link px-4 py-3"
                        href="#">
                        FLUX
                    </a>
                </li>

                <li class="nav-item">
                  <a id="lnkInicio" runat="server"
                    class="nav-link px-4 py-3"
                        href="DefaultVendedor.aspx">
                      <i class="bi bi-house-door me-2"></i>
                        Inicio
                   </a>
                </li>

                <li class="nav-item dropdown">
                    <div class="btn-group">

                        <!-- Al hacer clic acá va a Nueva Venta -->
                        <a id="lnkVentas" runat="server"
                            class="nav-link px-4 py-3"
                            href="VentaVendedor.aspx">
                            <i class="bi bi-cart me-2"></i>
                            Ventas
                        </a>

                        <!-- Flechita del dropdown -->
                        <a class="nav-link dropdown-toggle dropdown-toggle-split py-3"
                            href="#"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </a>

                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" href="MisVentas.aspx">
                                    Mis ventas
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="Cotizaciones.aspx">
                                    Cotizaciones
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="Estados.aspx">
                                    Estados
                                </a>
                            </li>
                        </ul>

                    </div>
                </li>

                <li class="nav-item">
                    <a id="lknClientes" runat="server"
                       class="nav-link px-4 py-3"
                        href= "Stock.aspx">
                        <i class="bi bi-people me-2"></i>
                        Stock
                    </a>
                </li>

                <li class="nav-item ms-auto">
                    <div class="input-group" style="width: 300px; margin-top: 8px;">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <asp:TextBox ID="txtBuscarCliente"
                            runat="server"
                            CssClass="form-control"
                            placeholder="Cliente">
                        </asp:TextBox>

                        <asp:Button ID="btnBuscarCliente"
                            runat="server"
                            Text="Buscar"
                            CssClass="btn btn-dark"
                            OnClick="btnBuscarCliente_Click1"
                            />
                    </div>
                </li>
              

            </ul>

        </div>

    </div>
</nav>
<asp:ContentPlaceHolder ID="MainContent" runat="server">
</asp:ContentPlaceHolder>
    </form>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
